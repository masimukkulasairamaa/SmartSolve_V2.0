# REQUIRED in production
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CLIENT_URL=http://localhost:5173
HTTP_PORT=5173

# Server
PORT=5000
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
TRUST_PROXY=true
MAX_JSON_BYTES=2

# Optional AI (OpenAI-compatible)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional translation (OpenAI-compatible)
TRANSLATION_API_KEY=
TRANSLATION_BASE_URL=
TRANSLATION_MODEL=

# Upload storage: local persistent Docker volume or S3-compatible object storage
STORAGE_PROVIDER=local
UPLOAD_DIR=/app/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# SOS
SOS_RADIUS_KM=50

# Never enable presentation data in production
DEMO_SEED=false
